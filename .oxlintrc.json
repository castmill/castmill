{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-unassigned-vars": "off",
    "no-unused-vars": "off"
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": [
    "node_modules",
    "dist",
    "build",
    "out",
    "android",
    "public/lib",
    "packages/castmill/assets/vendor"
  ]
}
