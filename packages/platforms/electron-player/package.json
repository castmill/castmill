{
  "name": "@castmill/electron-player",
  "version": "1.0.0",
  "description": "Castmill Player Electron App",
  "homepage": "https://electron-vite.org",
  "license": "AGPL-3.0-or-later",
  "author": "Castmill AB",
  "main": "./out/main/index.js",
  "scripts": {
    "format": "oxfmt --write .",
    "format:check": "oxfmt .",
    "lint": "oxlint .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "yarn typecheck:node && yarn typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "yarn typecheck && electron-vite build",
    "build2": "electron-vite build -l info",
    "guard:update-url": "node scripts/guard-update-url.cjs",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "CASTMILL_UPDATE_URL=https://updates.castmill.dev/electron yarn guard:update-url && yarn build && electron-builder --dir",
    "build:staging:mac": "CASTMILL_UPDATE_URL=https://updates.castmill.dev/electron yarn guard:update-url && electron-vite build && electron-builder --mac",
    "build:staging:linux": "CASTMILL_UPDATE_URL=https://updates.castmill.dev/electron yarn guard:update-url && electron-vite build && electron-builder --linux",
    "build:prod:mac": "CASTMILL_UPDATE_URL=https://updates.castmill.io/electron yarn guard:update-url && electron-vite build && electron-builder --mac",
    "build:prod:linux": "CASTMILL_UPDATE_URL=https://updates.castmill.io/electron yarn guard:update-url && electron-vite build && electron-builder --linux",
    "build:mac": "yarn build:staging:mac",
    "build:linux": "yarn build:staging:linux"
  },
  "dependencies": {
    "@castmill/cache": "*",
    "@castmill/device": "*",
    "@castmill/player": "*",
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/utils": "^3.0.0",
    "check-disk-space": "^3.4.0",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.1.7",
    "macaddress": "^0.5.3",
    "systeminformation": "^5.22.7"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/node": "^18.19.9",
    "electron": "^32.2.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.2.0",
    "solid-js": "^1.8.22",
    "typescript": "^5.7.3",
    "vite": "^5.0.12",
    "vite-plugin-solid": "^2.9.1",
    "vitest": "^1.5.3"
  }
}
